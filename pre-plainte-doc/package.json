{
  "name": "@ppel/pre-plainte-doc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:rules": "npm --prefix ../pre-plainte-ihm run docs:rules",
    "docs:dev": "npm run docs:rules && vitepress dev --host 0.0.0.0",
    "docs:build": "npm run docs:rules && vitepress build",
    "docs:preview": "vitepress preview --host 0.0.0.0"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}
