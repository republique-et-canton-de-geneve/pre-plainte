{
  "type": "module",
  "devDependencies": {
    "cypress": "^14.5.4",
    "@badeball/cypress-cucumber-preprocessor": "^22.2.0",
    "@cucumber/cucumber": "^12.1.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.5",
    "esbuild": "^0.25.9"
  },
  "scripts": {
    "cy:open": "node scripts/validate-features.js && cypress open",
    "cy:lint": "node scripts/validate-features.js",
    "cy:run": "node scripts/validate-features.js && node scripts/check-backend.js && cypress run --headless --e2e --spec \"cypress/e2e/*.feature\"",
    "cy:verify": "cypress verify"
  }
}
